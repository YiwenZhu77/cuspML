#!/bin/bash
# Example for NCAR Casper; adapt account and queue for another installation.
#PBS -N cusp_reproduction
#PBS -A P28100045
#PBS -q casper
#PBS -l select=1:ncpus=8:mem=16GB
#PBS -l walltime=00:40:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit this file from the repository root}"
CUSPML_PYTHON=${CUSPML_PYTHON:-.venv/bin/python}
exec "$CUSPML_PYTHON" -u reproduce/reproduce.py --train --jobs 6 --output-dir "results/pbs-${PBS_JOBID}"
