#!/bin/bash
# Compatibility launcher. Submit reproduce/run.pbs from the repository root.
#PBS -N cusp_reproduction_check
#PBS -A P28100045
#PBS -q casper
#PBS -l select=1:ncpus=4:mem=8GB
#PBS -l walltime=00:10:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit this file from the repository root}"
CUSPML_PYTHON=${CUSPML_PYTHON:-.venv/bin/python}
exec "$CUSPML_PYTHON" -u reproduce/reproduce.py --output-dir "results/pbs-${PBS_JOBID}"
