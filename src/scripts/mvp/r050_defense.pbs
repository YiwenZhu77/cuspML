#!/bin/bash
#PBS -N cuspml_defense
#PBS -A P28100045
#PBS -q casper
#PBS -l select=1:ncpus=36:mem=64GB
#PBS -l walltime=01:30:00
#PBS -j oe
#PBS -o /glade/work/yizhu/cuspML/src/scripts/mvp/r050_defense.log

set -e
PY=/glade/u/home/yizhu/work/miniconda3/envs/py3.10/bin/python
cd /glade/work/yizhu/cuspML
export OMP_NUM_THREADS=1   # let multiprocessing own the cores; XGBoost n_jobs set per script

echo "=== r050 fair NN search (parallel, 64 workers) ==="
$PY -u src/scripts/mvp/r050_fair_nn.py --workers 34

echo "=== r051 all-target dependence-aware validation ==="
OMP_NUM_THREADS=32 $PY -u src/scripts/mvp/r051_alltarget_validation.py

echo "=== r052 gap robustness ==="
OMP_NUM_THREADS=32 $PY -u src/scripts/mvp/r052_gap_robustness.py

echo "=== r053 error-decomposition robustness ==="
OMP_NUM_THREADS=32 $PY -u src/scripts/mvp/r053_errordecomp_robust.py

echo "=== ALL DEFENSE JOBS DONE ==="
